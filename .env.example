# Copy to .env and fill in real values before running `docker-compose up`.
# .env is gitignored — never commit real secrets.

MAIL_USERNAME=
MAIL_PASSWORD=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET=
IA_API_URL=http://localhost:5000/predict

# Docker Hub (used by the Jenkins pipeline, not by docker-compose)
DOCKERHUB_USERNAME=
