{
  "title": "Comping Backend",
  "uid": "comping-backend",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "JVM Heap Used",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{application=\"comping-backend\", area=\"heap\"})",
          "legendFormat": "heap used"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP Requests / sec",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"comping-backend\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} [{{status}}]"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 Latency",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"comping-backend\"}[5m])) by (le, uri))",
          "legendFormat": "{{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "system_cpu_usage{application=\"comping-backend\"}",
          "legendFormat": "system cpu"
        },
        {
          "expr": "process_cpu_usage{application=\"comping-backend\"}",
          "legendFormat": "process cpu"
        }
      ]
    }
  ]
}
